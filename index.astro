---
import Base from '../layouts/Base.astro';
import JobCard from '../components/JobCard.astro';
import {getCollection} from 'astro:content';
const today=new Date().toISOString().slice(0,10);
const jobs=(await getCollection('empleos')).filter(j=>!j.data.vence||j.data.vence>=today).sort((a,b)=>b.data.fecha.localeCompare(a.data.fecha));
const countries=[...new Set(jobs.map(j=>j.data.pais))].sort((a,b)=>a.localeCompare(b,'es'));
const categories=[...new Set(jobs.map(j=>j.data.categoria))].sort((a,b)=>a.localeCompare(b,'es'));
const icons={'Administración':'💼','Ventas':'📈','Atención al Cliente':'🎧','Hoteles y Turismo':'🛏️','Salud':'❤️','Tecnología':'💻','Construcción':'👷','Transporte':'🚚'};
const topCategories=['Administración','Ventas','Atención al Cliente','Hoteles y Turismo','Salud','Tecnología','Construcción','Transporte'];
---
<Base><section class="hero"><div class="hero-shade"><div class="wrap hero-content"><div class="hero-kicker">🌎 Oportunidades sin fronteras</div><h1>Encuentra tu próximo<br/> empleo <span>en cualquier lugar del mundo</span></h1><p>Explora oportunidades internacionales, locales y remotas.<br/>Tu próxima gran oportunidad comienza aquí.</p><form id="hero-form" class="hero-search"><label>🔎 <span><b>¿Qué empleo buscas?</b><input id="search-text" type="search" placeholder="Ej. Contador, Desarrollador, Recepcionista"/></span></label><label>🌐 <span><b>País</b><select id="country"><option value="">Todos los países</option>{countries.map(c=><option value={c}>{c}</option>)}</select></span></label><label>▦ <span><b>Categoría</b><select id="hero-category"><option value="">Todas las categorías</option>{categories.map(c=><option value={c}>{c}</option>)}</select></span></label><button type="submit">⌕ Buscar empleos</button></form></div></div></section>
<section class="category-band"><div class="wrap category-row" id="categorias">{topCategories.map(c=><button class="category-tile" data-category={c}><span>{icons[c]}</span><b>{c}</b><small>{jobs.filter(j=>j.data.categoria===c).length} vacantes</small></button>)}</div></section>
<section class="wrap main-area" id="vacantes"><div class="main-list"><div class="section-title"><div><h2>Empleos recientes</h2><div class="red-line"></div></div><span id="results-count">{jobs.length} vacantes</span></div><div class="job-list" id="job-list">{jobs.map(job=><JobCard job={job}/>)}</div><p id="empty" class="empty" hidden>No hay vacantes que coincidan con tu búsqueda. Prueba otros filtros.</p></div><aside class="sidebar"><div class="filter-panel"><h3>⚑ Búsqueda rápida</h3><label>Palabra clave<input id="side-search" placeholder="Ej. Diseñador, Chofer..."/></label><label>País<select id="side-country"><option value="">Todos los países</option>{countries.map(c=><option value={c}>{c}</option>)}</select></label><label>Categoría<select id="side-category"><option value="">Todas las categorías</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label><label>Modalidad<select id="mode"><option value="">Todas</option><option>Remoto</option><option>Presencial</option><option>Híbrido</option></select></label><button id="side-submit">⌕ Buscar ahora</button><button id="reset" class="reset">Limpiar filtros</button></div><div class="promo" id="empresas"><div><h3>Tu próxima oportunidad te espera</h3><p>Encuentra empleos de empresas de diferentes países.</p><a href="/publicar/">Publicar vacante ↗</a></div><span>🌍</span></div></aside></section>
<section class="stats"><div class="wrap stats-grid"><div><strong>{jobs.length}</strong><span>Vacantes disponibles</span></div><div><strong>{countries.length}</strong><span>Países con ofertas</span></div><div><strong>{categories.length}</strong><span>Categorías laborales</span></div><div><strong>🌎</strong><span>Alcance internacional</span></div></div></section>
<script>
const q=document.querySelector<HTMLInputElement>('#search-text')!;const c=document.querySelector<HTMLSelectElement>('#country')!;const cat=document.querySelector<HTMLSelectElement>('#hero-category')!;const sq=document.querySelector<HTMLInputElement>('#side-search')!;const sc=document.querySelector<HTMLSelectElement>('#side-country')!;const sCat=document.querySelector<HTMLSelectElement>('#side-category')!;const mode=document.querySelector<HTMLSelectElement>('#mode')!;
const cards=[...document.querySelectorAll<HTMLElement>('.job-card')];
function apply(){const query=(sq.value||q.value).trim().toLocaleLowerCase();const country=sc.value||c.value;const category=sCat.value||cat.value;const m=mode.value;let n=0;for(const card of cards){const ok=(!query||(card.dataset.search||'').includes(query))&&(!country||card.dataset.country===country)&&(!category||card.dataset.category===category)&&(!m||card.dataset.mode===m);card.hidden=!ok;if(ok)n++;}document.querySelector<HTMLElement>('#empty')!.hidden=n>0;document.querySelector('#results-count')!.textContent=`${n} vacantes`;}
function scrollJobs(){apply();document.querySelector('#vacantes')?.scrollIntoView({behavior:'smooth'});}
document.querySelector('#hero-form')?.addEventListener('submit',e=>{e.preventDefault();sq.value=q.value;sc.value=c.value;sCat.value=cat.value;scrollJobs();});document.querySelector('#side-submit')?.addEventListener('click',()=>{q.value=sq.value;c.value=sc.value;cat.value=sCat.value;scrollJobs();});for(const el of [q,c,cat,sq,sc,sCat,mode])el.addEventListener('input',apply);document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.addEventListener('click',()=>{cat.value=b.dataset.category||'';sCat.value=cat.value;scrollJobs();}));document.querySelector('#reset')?.addEventListener('click',()=>{q.value='';c.value='';cat.value='';sq.value='';sc.value='';sCat.value='';mode.value='';apply();});
</script></Base>
