lor:#7655f7;color:#545a70;background:#fff;font-size:12px}.panel .btn{width:100%;margin-top:20px}.panel-note{margin:15px 0 0;font-size:11px;line-height:1.7;color:#9298aa}.empty{background:#fff;border:1px dashed #d6d3ef;border-radius:19px;text-align:center;padding:56px 28px}.empty-icon{width:72px;height:72px;border-radius:22px;background:#eeeaff;color:#7959f4;font-size:34px;display:grid;place-items:center;margin:0 auto 18px}.empty h3{font:800 20px 'Plus Jakarta Sans',sans-serif;color:#222741;margin:0 0 10px}.empty p{color:#82889e;font-size:13px;line-height:1.8;max-width:480px;margin:0 auto}.pagination{display:flex;justify-content:center;align-items:center;gap:8px;flex-wrap:wrap;margin-top:22px}.pagination button{border:1px solid #e4e5f2;background:#fff;color:#5848b3;border-radius:9px;padding:10px 14px;font-weight:800;font-size:12px}.pagination button.active{background:#7555f6;color:#fff;border-color:#7555f6}.pagination button:disabled{opacity:.45;cursor:not-allowed}.rd-note{background:#fff;border:1px solid #e8eaf3;border-radius:12px;padding:12px 16px;color:#515c7b;font-size:12px;margin-bottom:14px}.hidden{display:none!important}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.feature{padding:29px;background:#fff;border:1px solid #e9ebf4;border-radius:18px}.feature-icon{width:50px;height:50px;border-radius:14px;background:#f0ecff;display:grid;place-items:center;font-size:25px;margin-bottom:19px}.feature h3{margin:0 0 10px;color:#262a43;font-size:17px}.feature p{margin:0;color:#858ba0;line-height:1.75;font-size:13px}.cta{padding:60px 0;background:linear-gradient(110deg,#292061,#6849d9);color:#fff}.cta-inner{display:flex;align-items:center;justify-content:space-between;gap:25px}.cta h2{font:800 30px 'Plus Jakarta Sans',sans-serif;margin:0 0 12px;letter-spacing:-1px}.cta p{margin:0;color:#e0dafa;font-size:14px;line-height:1.7}.cta .btn{background:#fff;color:#6142d4}.cta .btn:hover{background:#f4f0ff}.footer{background:#11152b;color:#b2b8ce;padding:52px