  <body>
    <div class="topline"></div>
    <header class="header">
      <div class="container nav">
        <a class="logo" href="/" aria-label="EmpléateHoy, inicio"><span class="logo-mark">✦</span><span><span class="logo-name">Empléate<span>Hoy</span></span><small class="logo-caption">OPORTUNIDADES SIN FRONTERAS</small></span></a>
        <nav class="nav-links" id="main-nav" aria-label="Navegación principal"><a href="#inicio">Inicio</a><a href="#vacantes">Explorar empleos</a><a href="#categorias">Categorías</a><a href="#ventajas">Cómo funciona</a></nav>
        <div class="nav-actions"><a class="btn btn-outline" href="mailto:TU_CORREO@EJEMPLO.COM?subject=Publicar%20una%20vacante%20en%20Empl%C3%A9ateHoy">+ Publicar empleo</a><button class="menu-btn" id="menu-toggle" aria-label="Abrir menú" aria-controls="main-nav" aria-expanded="false">☰</button></div>
      </div>
    </header>
    <main>
      <section class="hero" id="inicio"><div class="container hero-inner"><div>
        <span class="hero-badge">✦ &nbsp; Tu próxima oportunidad comienza aquí</span>
        <h1>Encuentra empleo en <span class="gradient-text">República Dominicana y el mundo.</span></h1>
        <p class="hero-description">Explora primero las oportunidades de República Dominicana, filtra por provincia y descubre también vacantes internacionales. Toda la información disponible se consulta aquí.</p>
        <div class="hero-trust"><span><i>✓</i> 🇩🇴 República Dominicana primero</span><span><i>✓</i> Trabajos remotos</span><span><i>✓</i> Información completa aquí</span></div>
      </div><div class="hero-art" aria-hidden="true"><div class="orbit"></div><div class="globe">🌐</div><div class="float-card float-one"><span class="bubble">💻</span><span><strong>Trabajo remoto</strong><small>Desde donde estés</small></span></div><div class="float-card float-two"><span class="bubble">🌍</span><span><strong>Alcance global</strong><small>Más oportunidades</small></span></div><div class="float-card float-three"><span class="bubble">✦</span><span><strong>Tu próximo paso</strong><small>Una carrera sin límites</small></span></div></div></div></section>
      <div class="container search-wrap"><form class="search-panel" id="search-form"><label class="search-field"><span aria-hidden="true">⌕</span><span class="visually-hidden">Puesto o palabra clave</span><input id="search-query" type="search" placeholder="Puesto, empresa o palabra clave" /></label><label class="search-field"><span aria-hidden="true">◎</span><span class="visually-hidden">País</span><select id="search-country"><option value="">Todos los países</option>{paises.map(p=><option value={p}>{p}</option>)}</select></label><label class="search-field"><span aria-hidden="true">▦</span><span class="visually-hidden">Modalidad</span><select id="search-mode"><option value="">Todas las modalidades</option><option value="Remoto">Remoto</option><option value="Presencial">Presencial</option><option value="Híbrido">Híbrido</option></select></label><button class="btn" type="submit">Buscar empleos ↗</button></form></div>
      <section class="section section-alt" id="categorias"><div class="container"><div class="section-head"><div><p class="kicker">DESCUBRE TU CAMINO</p><h2>Explora por categoría</h2><p class="section-sub">Encuentra oportunidades en el sector que más te apasiona.</p></div><a class="link-arrow" href="#vacantes">Ver vacantes ↗</a></div><div class="categories">{categorias.map(c=><button type="button" class="category" data-category={c.nombre}><span class={`category-icon ${c.clase}`}>{c.icono}</span><span><strong>{c.nombre}</strong><small>{c.detalle}</small></span></button>)}</div></div></section>
      <section class="section jobs-section" id="vacantes"><div class="container"><div class="section-head"><div><p class="kicker">TU SIGUIENTE GRAN PASO</p><h2>Oportunidades recientes</h2><p class="section-sub">Consulta los detalles completos de cada vacante sin salir de EmpléateHoy.</p></div><span class="link-arrow" id="job-count">Cargando vacantes…</span></div><div class="jobs-layout"><div><div class="rd-note">🇩🇴 Mostramos primero las oportunidades de República Dominicana. Puedes cambiar el país en los filtros.</div><p class="status" id="job-status" role="status" aria-live="polite">Buscando ofertas disponibles…</p><div class="jobs-list" id="jobs-list"><div class="empty"><span class="empty-icon">⌛</span><h3>Cargando oportunidades</h3><p>Estamos consultando el listado de empleos.</p></div></div><nav class="pagination" id="job-pagination" aria-label="Páginas de vacantes"></nav><p class="notice">Publicamos información disponible de las vacantes. Verifica su vigencia y las condiciones con la empresa antes de postularte.</p></div><aside class="panel"><h3>⚙️ Filtrar oportunidades</h3><form id="filter-form"><label class="filter-label" for="filter-keyword">Palabra clave</label><input class="filter-control" id="filter-keyword" type="search" placeholder="Ej. Desarrollador, ventas..." /><label class="filter-label" for="filter-country">País</label><select class="filter-control" id="filter-country"><option value="">Todos los países</option>{paises.map(p=><option value={p}>{p}</option>)}</select><label class="filter-label" for="filter-mode">Modalidad</label><select class="filter-control" id="filter-mode"><option value="">Todas</option><option value="Remoto">Remoto</option><option value="Presencial">Presencial</option><option value="Híbrido">Híbrido</option></select><label class="filter-label" for="filter-category">Categoría</label><select class="filter-control" id="filter-category"><option value="">Todas las categorías</option>{categorias.map(c=><option value={c.nombre}>{c.nombre}</option>)}</select><label class="filter-label" for="filter-province">Provincia (República Dominicana)</label><select class="filter-control" id="filter-province"><option value="">Todas las provincias</option>{provinciasRD.map(p=><option value={p}>{p}</option>)}</select><button type="submit" class="btn">Aplicar filtros ↗</button><button type="button" class="btn btn-outline" id="clear-filters">Limpiar filtros</button></form><p class="panel-note">Solo mostramos vacantes incorporadas al archivo de datos. No inventamos ofertas.</p></aside></div></div></section>
      <section class="section section-alt" id="ventajas"><div class="container"><div class="section-head"><div><p class="kicker">CRECE SIN LÍMITES</p><h2>Tu carrera, a tu manera</h2><p class="section-sub">Una forma sencilla de descubrir nuevas posibilidades profesionales.</p></div></div><div class="features"><article class="feature"><span class="feature-icon">🌍</span><h3>Un mundo de opciones</h3><p>Encuentra oportunidades en distintos países y amplía tu búsqueda profesional.</p></article><article class="feature"><span class="feature-icon">💻</span><h3>Flexibilidad laboral</h3><p>Filtra entre trabajos remotos, presenciales e híbridos según tu preferencia.</p></article><article class="feature"><span class="feature-icon">🔗</span><h3>Postulación directa</h3><p>Consulta aquí los requisitos y utiliza el canal oficial indicado para postularte.</p></article></div></div></section>
      <section class="cta"><div class="container cta-inner"><div><h2>El mejor talento no tiene fronteras.</h2><p>¿Representas una empresa? Comparte tus oportunidades con profesionales de todo el mundo.</p></div><a class="btn" href="mailto:TU_CORREO@EJEMPLO.COM?subject=Publicar%20vacante%20en%20Empl%C3%A9ateHoy">Publicar una vacante ↗</a></div></section>
    </main>
    <footer class="footer"><div class="container"><div class="footer-grid"><div><a class="logo" href="/"><span class="logo-mark">✦</span><span><span class="logo-name">Empléate<span>Hoy</span></span><small class="logo-caption">OPORTUNIDADES SIN FRONTERAS</small></span></a><p>Acercamos oportunidades laborales internacionales a profesionales que buscan crecer.</p></div><div><h3>Explorar</h3><a class="footer-link" href="#vacantes">Buscar empleos</a><a class="footer-link" href="#categorias">Categorías</a><a class="footer-link" href="#ventajas">Cómo funciona</a></div><div><h3>Empleadores</h3><a class="footer-link" href="mailto:TU_CORREO@EJEMPLO.COM?subject=Publicar%20vacante">Publicar empleo</a><a class="footer-link" href="mailto:TU_CORREO@EJEMPLO.COM?subject=Contacto%20Empl%C3%A9ateHoy">Contacto</a></div></div><div class="footer-bottom">© {new Date().getFullYear()} EmpléateHoy. Todos los derechos reservados.</div></div></footer>
    <script>
      type Job = {slug?:string;id:string;titulo:string;empresa:string;pais?:string;ubicacion?:string;ciudad?:string;modalidad?:string;categoria?:string;descripcion:string;url?:string;aplicarUrl?:string;fecha?:string;salario?:string;vence?:string};
      const crearSlug = (valor:unknown) => String(valor ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9-]/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'');
      const slugVacante = (j:Job) => crearSlug(j.id);
      const vacanteValida = (j:Job) => Boolean(j && j.id && j.titulo && j.empresa && j.descripcion?.trim().length >= 120);
      const $ = (id:string) => document.getElementById(id);
      const norm = (value:unknown) => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
      const text = (id:string) => ($(id) as HTMLInputElement | HTMLSelectElement | null)?.value || '';
      let jobs:Job[]=[];
       let currentPage=1;
       const pageSize=12;
       let currentFilters={query:'',country:'',mode:'',category:'',province:''};
       const isRD=(j:Job)=>['republica dominicana','dominican republic','rd','do'].includes(norm(j.pais));
      const list=$('jobs-list')!;
      const status=$('job-status')!;
      const count=$('job-count')!;
      const safeUrl=(url:string)=>{try{const parsed=new URL(url);return ['https:','http:'].includes(parsed.protocol)?parsed.href:null}catch{return null}};
      function render(query='',country='',mode='',category='',province=''){
         currentFilters={query,country,mode,category,province};
        const today=new Date().toISOString().slice(0,10);
        const valid=jobs.filter(j=>vacanteValida(j) && (!j.vence || j.vence>=today));
        const matches=valid.filter(j=>{
          const haystack=norm([j.titulo,j.empresa,j.categoria,j.ciudad,j.ubicacion,j.pais,j.modalidad,j.descripcion].join(' '));
          return (!query||haystack.includes(norm(query)))&&(!country||norm(j.pais)===norm(country))&&(!mode||norm(j.modalidad)===norm(mode))&&(!category||norm(j.categoria)===norm(category))&&(!province||(isRD(j)&&norm([j.ciudad,j.ubicacion].join(' ')).includes(norm(province))));
        });
        matches.sort((a,b)=>Number(isRD(b))-Number(isRD(a)) || String(b.fecha||'').localeCompare(String(a.fecha||'')));
        const totalPages=Math.max(1,Math.ceil(matches.length/pageSize));
        currentPage=Math.min(currentPage,totalPages);
        const pageJobs=matches.slice((currentPage-1)*pageSize,currentPage*pageSize);
        list.replaceChildren();
        const pagination=$('job-pagination')!;pagination.replaceChildren();
        count.textContent=`${matches.length} ${matches.length===1?'vacante':'vacantes'}`;
        status.textContent=jobs.length?'Resultados de tu búsqueda':'Vacantes pendientes de integración';
        if(!matches.length){
          const empty=document.createElement('div');empty.className='empty';
          const symbol=document.createElement('span');symbol.className='empty-icon';symbol.textContent='✦';
          const title=document.createElement('h3');title.textContent=jobs.length?'No encontramos vacantes con esos filtros':'Próximamente, empleos de todo el mundo';
          const message=document.createElement('p');message.textContent=jobs.length?'Prueba otra palabra clave, país o modalidad.':'La plantilla ya está lista. Cuando conectemos Google Apps Script y publiquemos vacantes verificadas en public/jobs.json, aparecerán aquí automáticamente.';
          empty.append(symbol,title,message);list.append(empty);return;
        }
        for(const job of pageJobs){
          const card=document.createElement('article');card.className='job-card';
          const logo=document.createElement('div');logo.className='company-icon';logo.textContent=job.empresa.slice(0,1).toUpperCase();
          const main=document.createElement('div');main.className='job-main';
          const heading=document.createElement('h3');heading.textContent=job.titulo;
          const sub=document.createElement('p');sub.textContent=[job.empresa,job.ciudad||job.ubicacion,job.pais].filter(Boolean).join(' · ');
          const tags=document.createElement('div');tags.className='job-tags';
          for(const item of [job.modalidad,job.categoria,job.salario]){if(!item)continue;const tag=document.createElement('span');tag.className='tag';tag.textContent=item;tags.append(tag)}
          main.append(heading,sub,tags);
          const apply=document.createElement('a');apply.className='btn job-apply';apply.textContent='Ver vacante completa →';apply.href=`/empleos/${slugVacante(job)}/`;
          card.append(logo,main,apply);list.append(card);
        }
         if(totalPages>1){
           const addPage=(label:string,page:number,disabled=false,active=false)=>{const b=document.createElement('button');b.type='button';b.textContent=label;b.disabled=disabled;if(active)b.className='active';b.addEventListener('click',()=>{currentPage=page;render(currentFilters.query,currentFilters.country,currentFilters.mode,currentFilters.category,currentFilters.province);$('vacantes')?.scrollIntoView({behavior:'smooth',block:'start'})});pagination.append(b)};
           addPage('← Anterior',currentPage-1,currentPage===1);
           const first=Math.max(1,currentPage-2),last=Math.min(totalPages,first+4);
           for(let p=first;p<=last;p++)addPage(String(p),p,false,p===currentPage);
           addPage('Siguiente →',currentPage+1,currentPage===totalPages);
         }
      }
      async function loadJobs(){
        try{const response=await fetch('/jobs.json',{cache:'no-store'});if(!response.ok)throw new Error('Sin archivo de vacantes');const data:unknown=await response.json();if(!Array.isArray(data))throw new Error('Formato JSON incorrecto');jobs=data.filter((j):j is Job=>typeof j==='object'&&j!==null&&typeof j.id==='string'&&typeof j.titulo==='string'&&typeof j.empresa==='string'&&typeof j.descripcion==='string');}
        catch{jobs=[]}render();
      }
      function applyFilters(query:string,country:string,mode:string,category='',province=''){
         currentPage=1;
        ($('filter-keyword') as HTMLInputElement).value=query;
        ($('filter-country') as HTMLSelectElement).value=country;
        ($('filter-mode') as HTMLSelectElement).value=mode;
        ($('filter-category') as HTMLSelectElement).value=category;
        ($('filter-province') as HTMLSelectElement).value=province;
        render(query,country,mode,category,province);
        $('vacantes')?.scrollIntoView({behavior:'smooth',block:'start'});
      }
      $('search-form')?.addEventListener('submit',e=>{e.preventDefault();applyFilters(text('search-query'),text('search-country'),text('search-mode'))});
      $('filter-form')?.addEventListener('submit',e=>{e.preventDefault();applyFilters(text('filter-keyword'),text('filter-country'),text('filter-mode'),text('filter-category'),text('filter-province'))});
      $('clear-filters')?.addEventListener('click',()=>{(['filter-keyword','filter-country','filter-mode','filter-category','filter-province','search-query','search-country','search-mode'] as const).forEach(id=>{const el=$(id) as HTMLInputElement | HTMLSelectElement | null;if(el)el.value=''});currentPage=1;render()});
      document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(button=>button.addEventListener('click',()=>applyFilters('','','',button.dataset.category||'')));
      const toggle=$('menu-toggle');const nav=$('main-nav');toggle?.addEventListener('click',()=>{const open=nav?.classList.toggle('open')||false;toggle.setAttribute('aria-expanded',String(open))});nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');toggle?.setAttribute('aria-expanded','false')}));
      void loadJobs();
    </script>
  </body>
</html>
