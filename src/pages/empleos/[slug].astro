
---
import empleos from '../../../public/jobs.json';

export const prerender = true;

const crearSlug = (valor) =>
  String(valor ?? '')
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');

export function getStaticPaths() {
  const usados = new Set();

  return empleos
    .filter((empleo) =>
      empleo &&
      empleo.id &&
      empleo.titulo &&
      empleo.empresa
    )
    .map((empleo) => ({
      empleo,
      slug: crearSlug(empleo.id)
    }))
    .filter(({ slug }) => {
      if (!slug || usados.has(slug)) return false;
      usados.add(slug);
      return true;
    })
    .map(({ empleo, slug }) => ({
      params: { slug },
      props: { empleo }
    }));
}

const { empleo } = Astro.props;

const titulo = String(empleo.titulo || 'Oferta de empleo');
const empresa = String(empleo.empresa || 'Empresa no especificada');
const ubicacion = String(
  empleo.ubicacion || empleo.pais || 'No especificada'
);
const modalidad = String(empleo.modalidad || '');
const salario = String(empleo.salario || '');
const categoria = String(empleo.categoria || '');
const tipo = String(empleo.tipo || '');
const fecha = String(empleo.fecha || '');
const fuente = String(empleo.fuente || 'Fuente original');
const descripcion = String(empleo.descripcion || '').trim();

const enlaceOriginal = String(
  empleo.aplicarUrl || empleo.url || ''
);

const urlPostulacion = /^https:\/\/[^\s]+$/i.test(enlaceOriginal)
  ? enlaceOriginal
  : '';

const urlActual = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

const resumenSEO =
  `Conoce la oferta de ${titulo} en ${empresa}. ` +
  `Ubicación: ${ubicacion}. Consulta requisitos, ` +
  `información del puesto y cómo postularte.`;

const relacionados = empleos
  .filter((otro) =>
    otro.id !== empleo.id &&
    otro.titulo &&
    otro.empresa &&
    otro.id
  )
  .filter((otro) =>
    otro.categoria === empleo.categoria ||
    otro.modalidad === empleo.modalidad
  )
  .slice(0, 6);

const fechaValida =
  /^\d{4}-\d{2}-\d{2}$/.test(fecha) &&
  !Number.isNaN(Date.parse(fecha));

const fechaExpiracion =
  /^\d{4}-\d{2}-\d{2}$/.test(String(empleo.vence || ''))
    ? String(empleo.vence)
    : '';

const jsonLD = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: titulo,
  description: descripcion || resumenSEO,
  hiringOrganization: {
    '@type': 'Organization',
    name: empresa
  },
  ...(fechaValida ? { datePosted: fecha } : {}),
  ...(fechaExpiracion ? { validThrough: fechaExpiracion } : {}),
  ...(modalidad.toLowerCase() === 'remoto'
    ? {
        jobLocationType: 'TELECOMMUTE',
        applicantLocationRequirements: {
          '@type': 'Place',
          name: ubicacion
        }
      }
    : {
        jobLocation: {
          '@type': 'Place',
          address: {
            '@type': 'PostalAddress',
            addressLocality: ubicacion
          }
        }
      }),
  url: urlActual,
  ...(tipo ? { employmentType: tipo } : {})
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11152e" />

    <title>{titulo} en {empresa} | EmpléateHoy</title>
    <meta name="description" content={resumenSEO} />
    <link rel="canonical" href={urlActual} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${titulo} | EmpléateHoy`} />
    <meta property="og:description" content={resumenSEO} />
    <meta property="og:url" content={urlActual} />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLD).replace(/</g, '\\u003c')}
    />

    <style>
      :global(*) { box-sizing: border-box; }

      :global(body) {
        margin: 0;
        background: #f6f7fc;
        color: #222741;
        font-family: 'DM Sans', Arial, sans-serif;
      }

      :global(a) { text-decoration: none; }

      .topline {
        height: 4px;
        background: linear-gradient(90deg,#7154f5,#34c5e8,#ff5aab);
      }

      .header {
        background: white;
        border-bottom: 1px solid #edf0f8;
      }

      .container {
        width: min(1150px, calc(100% - 36px));
        margin: auto;
      }

      .nav {
        min-height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .logo {
        font: 800 24px 'Plus Jakarta Sans',sans-serif;
        letter-spacing: -1px;
        color: #191d36;
      }

      .logo span { color: #7655f7; }

      .navlink {
        font-size: 13px;
        font-weight: 800;
        color: #7655f7;
      }

      .hero {
        background:
          radial-gradient(ellipse at 80% 20%,#6545b570,transparent 50%),
          linear-gradient(125deg,#13162e,#251e53);
        padding: 54px 0 65px;
        color: white;
      }

      .breadcrumb {
        font-size: 12px;
        color: #d4ccff;
        margin-bottom: 23px;
        line-height: 1.7;
      }

      .breadcrumb a { color: #d4ccff; }

      h1 {
        font: 800 clamp(28px,4vw,45px)/1.2 'Plus Jakarta Sans',sans-serif;
        letter-spacing: -1.3px;
        max-width: 850px;
        margin: 0 0 18px;
      }

      .hero p {
        margin: 0;
        color: #d5d5ed;
        line-height: 1.7;
      }

      .hero-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 22px;
      }

      .hero-tag {
        padding: 9px 13px;
        background: #ffffff18;
        border: 1px solid #ffffff25;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
      }

      .layout {
        display: grid;
        grid-template-columns: minmax(0,1fr) 315px;
        gap: 23px;
        align-items: start;
        padding: 36px 0 70px;
      }

      .card {
        background: white;
        border: 1px solid #e8eaf3;
        border-radius: 18px;
        padding: 28px;
        margin-bottom: 20px;
        box-shadow: 0 8px 28px #20265308;
      }

      h2 {
        font: 800 21px 'Plus Jakarta Sans',sans-serif;
        margin: 0 0 20px;
        color: #222741;
      }

      .details {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 20px;
      }

      .detail small {
        display: block;
        color: #858ba0;
        font-size: 12px;
        margin-bottom: 6px;
      }

      .detail strong {
        display: block;
        font-size: 14px;
        overflow-wrap: anywhere;
      }

      .description {
        font-size: 15px;
        line-height: 1.95;
        color: #50566e;
        white-space: pre-line;
        overflow-wrap: anywhere;
      }

      .notice {
        border-left: 4px solid #7555f6;
        background: #f5f2ff;
        padding: 16px;
        border-radius: 8px;
        font-size: 13px;
        line-height: 1.8;
        color: #585474;
      }

      .btn {
        display: block;
        text-align: center;
        background: #7555f6;
        color: white;
        border-radius: 12px;
        padding: 16px;
        font-size: 14px;
        font-weight: 800;
        margin: 17px 0;
      }

      .btn:hover { background: #5d3dd9; }

      .small {
        font-size: 12px;
        color: #858ba0;
        line-height: 1.8;
      }

      .related {
        display: block;
        padding: 15px 0;
        border-bottom: 1px solid #edf0f7;
        color: #242942;
      }

      .related strong {
        display: block;
        font-size: 13px;
        margin-bottom: 6px;
      }

      .related span {
        color: #858ba0;
        font-size: 12px;
      }

      .footer {
        background: #11152b;
        color: #b2b8ce;
        text-align: center;
        padding: 35px 18px;
        font-size: 13px;
      }

      @media(max-width:800px) {
        .layout { grid-template-columns: 1fr; }
      }

      @media(max-width:520px) {
        .card { padding: 20px; }
        .details { grid-template-columns: 1fr; }
        .hero { padding: 40px 0 50px; }
        .logo { font-size: 21px; }
      }
    </style>
  </head>

  <body>
    <div class="topline"></div>

    <header class="header">
      <div class="container nav">
        <a href="/" class="logo">
          Empléate<span>Hoy</span>
        </a>
        <a href="/#vacantes" class="navlink">
          Explorar empleos ↗
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Inicio</a> /
            <a href="/#vacantes">Empleos</a> /
            {titulo}
          </div>

          <h1>{titulo}</h1>

          <p>
            {empresa} · {ubicacion}
          </p>

          <div class="hero-tags">
            {modalidad && <span class="hero-tag">{modalidad}</span>}
            {categoria && <span class="hero-tag">{categoria}</span>}
            {salario && <span class="hero-tag">{salario}</span>}
          </div>
        </div>
      </section>

      <div class="container layout">
        <div>
          <section class="card">
            <h2>Información de la vacante</h2>

            <div class="details">
              <div class="detail">
                <small>Empresa</small>
                <strong>{empresa}</strong>
              </div>

              <div class="detail">
                <small>Ubicación</small>
                <strong>{ubicacion}</strong>
              </div>

              <div class="detail">
                <small>Modalidad</small>
                <strong>{modalidad || 'No especificada'}</strong>
              </div>

              <div class="detail">
                <small>Tipo de empleo</small>
                <strong>{tipo || 'No especificado'}</strong>
              </div>

              <div class="detail">
                <small>Salario</small>
                <strong>{salario || 'No publicado'}</strong>
              </div>

              <div class="detail">
                <small>Fecha de publicación</small>
                <strong>{fecha || 'No especificada'}</strong>
              </div>
            </div>
          </section>

          <section class="card">
            <h2>Descripción del empleo</h2>

            <div class="description">
              {
                descripcion ||
                'Consulta los detalles completos de esta oportunidad en la fuente original.'
              }
            </div>
          </section>

          <section class="card">
            <h2>Cómo postularte</h2>

            <p class="description">
              Si esta oportunidad se ajusta a tu perfil,
              consulta los requisitos vigentes y completa
              tu solicitud mediante el enlace oficial
              del anuncio.
            </p>

            {
              urlPostulacion &&
              <a
                class="btn"
                href={urlPostulacion}
                target="_blank"
                rel="noopener noreferrer nofollow"
              >
                Postularme a esta vacante ↗
              </a>
            }

            <div class="notice">
              EmpléateHoy es un portal informativo de
              oportunidades laborales. La contratación
              y el proceso de selección corresponden
              a la empresa o plataforma de origen.
              Nunca pagues dinero para conseguir
              una entrevista o una oferta de empleo.
            </div>
          </section>
        </div>

        <aside>
          <section class="card">
            <h2>¿Te interesa?</h2>

            <p class="small">
              Consulta la publicación original para
              verificar que la vacante siga disponible.
            </p>

            {
              urlPostulacion &&
              <a
                class="btn"
                href={urlPostulacion}
                target="_blank"
                rel="noopener noreferrer nofollow"
              >
                Solicitar empleo ↗
              </a>
            }

            <p class="small">
              Fuente: {fuente}
            </p>
          </section>

          {
            relacionados.length > 0 &&
            <section class="card">
              <h2>Empleos relacionados</h2>

              {
                relacionados.map((otro) => (
                  <a
                    class="related"
                    href={`/empleos/${crearSlug(otro.id)}/`}
                  >
                    <strong>{otro.titulo}</strong>
                    <span>{otro.empresa}</span>
                  </a>
                ))
              }
            </section>
          }
        </aside>
      </div>
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} EmpléateHoy.
      Oportunidades sin fronteras.
    </footer>
  </body>
</html>
