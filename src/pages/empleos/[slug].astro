
---
import jobsData from '../../../public/jobs.json';

export const prerender = true;

/*
 * EMPLÉATEHOY
 * Página individual de vacantes
 * Compatible con Astro + GitHub + Cloudflare Pages
 */

type Job = {
  id?: string | number;
  slug?: string;
  titulo?: string;
  empresa?: string;
  pais?: string;
  ciudad?: string;
  ubicacion?: string;
  modalidad?: string;
  categoria?: string;
  tipo?: string;
  salario?: string;
  idioma?: string;
  descripcion?: string;
  requisitos?: string;
  responsabilidades?: string;
  fecha?: string;
  vence?: string;
  url?: string;
  aplicarUrl?: string;
  fuente?: string;
  fuenteUrl?: string;
  seoTitle?: string;
  seoDescription?: string;
};

function texto(valor: unknown): string {
  return String(valor ?? '').trim();
}

function crearSlug(valor: unknown): string {
  return texto(valor)
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function fechaValida(valor: unknown): string | undefined {
  const fecha = texto(valor);

  if (!/^\d{4}-\d{2}-\d{2}$/.test(fecha)) {
    return undefined;
  }

  const parsed = new Date(`${fecha}T00:00:00Z`);

  if (
    Number.isNaN(parsed.getTime()) ||
    parsed.toISOString().slice(0, 10) !== fecha
  ) {
    return undefined;
  }

  return fecha;
}

export function getStaticPaths() {
  const trabajos = Array.isArray(jobsData)
    ? (jobsData as Job[])
    : [];

  const usados = new Set<string>();

  return trabajos
    .filter((trabajo) => {
      return (
        trabajo &&
        texto(trabajo.id) &&
        texto(trabajo.titulo)
      );
    })
    .map((trabajo) => {
      /*
       * Se conserva el ID como slug para mantener
       * compatibilidad con los enlaces actuales
       * de la portada de EmpléateHoy.
       */
      const slug = crearSlug(trabajo.id);

      return {
        slug,
        trabajo
      };
    })
    .filter(({ slug }) => {
      if (!slug || usados.has(slug)) {
        return false;
      }

      usados.add(slug);
      return true;
    })
    .map(({ slug, trabajo }) => ({
      params: {
        slug
      },
      props: {
        trabajo
      }
    }));
}

const { trabajo } = Astro.props as {
  trabajo: Job;
};

const titulo = texto(trabajo.titulo);
const empresa = texto(trabajo.empresa) || 'Empresa no especificada';

const ubicacion =
  texto(trabajo.ubicacion) ||
  [texto(trabajo.ciudad), texto(trabajo.pais)]
    .filter(Boolean)
    .join(', ') ||
  'Ubicación no especificada';

const descripcion = texto(trabajo.descripcion);

const tituloSEO =
  texto(trabajo.seoTitle) ||
  `${titulo} - ${empresa} | EmpléateHoy`;

const descripcionSEO =
  texto(trabajo.seoDescription) ||
  `Conoce la vacante de ${titulo} en ${empresa}. Ubicación: ${ubicacion}. Consulta los requisitos y cómo aplicar en EmpléateHoy.`;

const metaDescripcion = descripcionSEO.slice(0, 160);

const canonical = new URL(
  Astro.url.pathname,
  Astro.site || Astro.url.origin
).href;

const fechaPublicacion = fechaValida(trabajo.fecha);
const fechaVencimiento = fechaValida(trabajo.vence);

const esRemoto = /remot|teletrabaj|work from home/i.test(
  texto(trabajo.modalidad)
);

const pais = texto(trabajo.pais);
const ciudad = texto(trabajo.ciudad);

const tipoEmpleo = texto(trabajo.tipo);

const tiposValidos = [
  'FULL_TIME',
  'PART_TIME',
  'CONTRACTOR',
  'TEMPORARY',
  'INTERN',
  'VOLUNTEER',
  'PER_DIEM',
  'OTHER'
];

function normalizarTipo(valor: string): string | undefined {
  const normalizado = valor.toUpperCase();

  if (tiposValidos.includes(normalizado)) {
    return normalizado;
  }

  if (/tiempo completo|full.time|jornada completa/i.test(valor)) {
    return 'FULL_TIME';
  }

  if (/medio tiempo|part.time|tiempo parcial/i.test(valor)) {
    return 'PART_TIME';
  }

  if (/pasant|internship|interno/i.test(valor)) {
    return 'INTERN';
  }

  if (/contrato temporal|temporary/i.test(valor)) {
    return 'TEMPORARY';
  }

  return undefined;
}

const tipoSchema = normalizarTipo(tipoEmpleo);

const jobPosting = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: titulo,
  description: descripcion,
  identifier: {
    '@type': 'PropertyValue',
    name: 'EmpléateHoy',
    value: texto(trabajo.id)
  },
  hiringOrganization: {
    '@type': 'Organization',
    name: empresa
  },
  url: canonical,

  ...(fechaPublicacion
    ? { datePosted: fechaPublicacion }
    : {}),

  ...(fechaVencimiento
    ? { validThrough: `${fechaVencimiento}T23:59:59-04:00` }
    : {}),

  ...(tipoSchema
    ? { employmentType: tipoSchema }
    : {}),

  ...(pais || ciudad
    ? {
        jobLocation: {
          '@type': 'Place',
          address: {
            '@type': 'PostalAddress',
            ...(ciudad ? { addressLocality: ciudad } : {}),
            ...(pais ? { addressCountry: pais } : {})
          }
        }
      }
    : {}),

  ...(esRemoto
    ? { jobLocationType: 'TELECOMMUTE' }
    : {})
};

const datosEstructurados = JSON.stringify(jobPosting)
  .replace(/</g, '\\u003c');

const idioma = texto(trabajo.idioma) || 'es';
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{tituloSEO}</title>

    <meta
      name="description"
      content={metaDescripcion}
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloSEO} />
    <meta
      property="og:description"
      content={metaDescripcion}
    />
    <meta property="og:url" content={canonical} />

    <script
      type="application/ld+json"
      set:html={datosEstructurados}
    />

    <style>
      :root {
        --azul: #123c7a;
        --azul-oscuro: #09295b;
        --rojo: #e63946;
        --fondo: #f4f7fc;
        --texto: #24344b;
        --borde: #e2e8f0;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--fondo);
        color: var(--texto);
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.7;
      }

      a {
        color: var(--azul);
      }

      .contenedor {
        width: min(1050px, calc(100% - 32px));
        margin: auto;
      }

      header {
        background: white;
        border-bottom: 1px solid var(--borde);
      }

      .navegacion {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
      }

      .logo {
        font-size: 27px;
        font-weight: 900;
        color: var(--azul);
        text-decoration: none;
      }

      .logo span {
        color: var(--rojo);
      }

      .volver {
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
      }

      main {
        padding: 38px 0 65px;
      }

      .tarjeta {
        background: white;
        border: 1px solid var(--borde);
        border-radius: 18px;
        padding: clamp(20px, 4vw, 42px);
        box-shadow: 0 8px 28px rgba(10, 35, 80, 0.06);
      }

      .etiqueta {
        color: var(--rojo);
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      h1 {
        margin: 12px 0;
        color: var(--azul-oscuro);
        font-size: clamp(27px, 4vw, 39px);
        line-height: 1.25;
        overflow-wrap: anywhere;
      }

      h2 {
        color: var(--azul);
        font-size: 22px;
        margin: 30px 0 12px;
      }

      .empresa {
        font-size: 18px;
        font-weight: 700;
      }

      .detalles {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 24px 0;
      }

      .detalle {
        background: #edf4ff;
        color: #1d4c87;
        padding: 8px 13px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
      }

      .descripcion {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-size: 16px;
        line-height: 1.85;
      }

      .aviso {
        margin-top: 32px;
        padding-top: 18px;
        border-top: 1px solid var(--borde);
        font-size: 13px;
        color: #64748b;
      }

      footer {
        background: var(--azul-oscuro);
        color: white;
        text-align: center;
        padding: 25px 15px;
        font-size: 14px;
      }

      @media (max-width: 600px) {
        .logo {
          font-size: 22px;
        }

        .volver {
          font-size: 12px;
        }

        main {
          padding-top: 20px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="contenedor navegacion">
        <a href="/" class="logo">
          Empléate<span>Hoy</span>
        </a>

        <a href="/" class="volver">
          ← Volver a empleos
        </a>
      </div>
    </header>

    <main class="contenedor">
      <article class="tarjeta">

        <div class="etiqueta">
          Oportunidad laboral
        </div>

        <h1>{titulo}</h1>

        <div class="empresa">{empresa}</div>

        <div class="detalles">
          <span class="detalle">📍 {ubicacion}</span>

          {trabajo.modalidad && (
            <span class="detalle">
              💻 {trabajo.modalidad}
            </span>
          )}

          {trabajo.tipo && (
            <span class="detalle">
              💼 {trabajo.tipo}
            </span>
          )}

          {trabajo.categoria && (
            <span class="detalle">
              📂 {trabajo.categoria}
            </span>
          )}

          {fechaPublicacion && (
            <span class="detalle">
              📅 {fechaPublicacion}
            </span>
          )}
        </div>

        <h2>Descripción completa del empleo</h2>

        <div class="descripcion">
          {descripcion || 'Descripción no disponible.'}
        </div>

        {trabajo.requisitos && (
          <section>
            <h2>Requisitos</h2>
            <div class="descripcion">
              {trabajo.requisitos}
            </div>
          </section>
        )}

        {trabajo.responsabilidades && (
          <section>
            <h2>Responsabilidades</h2>
            <div class="descripcion">
              {trabajo.responsabilidades}
            </div>
          </section>
        )}

        {trabajo.salario && (
          <section>
            <h2>Salario</h2>
            <p>{trabajo.salario}</p>
          </section>
        )}

        {fechaVencimiento && (
          <section>
            <h2>Fecha límite de aplicación</h2>
            <p>{fechaVencimiento}</p>
          </section>
        )}

        <p class="aviso">Consulta los requisitos y la vigencia de esta oportunidad antes de postularte.</p>
      </article>
    </main>

    <footer>
      © {new Date().getFullYear()} EmpléateHoy.
      Todos los derechos reservados.
    </footer>
  </body>
</html>
