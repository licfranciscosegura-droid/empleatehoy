---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';
export async function getStaticPaths(){const today=new Date().toISOString().slice(0,10);return (await getCollection('empleos')).filter(j=>!j.data.vence||j.data.vence>=today).map(job=>({params:{id:job.id},props:{job}}));}
const {job}=Astro.props;const d=job.data;
const structured=d.demostracion?null:{'@context':'https://schema.org','@type':'JobPosting',title:d.titulo,description:d.descripcion,datePosted:d.fecha,...(d.vence?{validThrough:d.vence+'T23:59:59Z'}:{}),employmentType:d.tipo==='Tiempo completo'?'FULL_TIME':d.tipo==='Medio tiempo'?'PART_TIME':'OTHER',hiringOrganization:{'@type':'Organization',name:d.empresa},jobLocationType:d.modalidad==='Remoto'?'TELECOMMUTE':undefined,...(d.modalidad==='Remoto'?{}:{jobLocation:{'@type':'Place',address:{'@type':'PostalAddress',addressLocality:d.ciudad,addressCountry:d.pais}}}),directApply:false};
---
<Base title={`${d.titulo} | ${d.empresa} | EmpléateHoy`} description={`${d.titulo} en ${d.pais}. ${d.descripcion.slice(0,125)}`}>
{structured&&<script type="application/ld+json" set:html={JSON.stringify(structured)}/>}
<section class="detail-section"><div class="wrap"><a class="back" href="/#vacantes">← Volver a empleos</a><article class="detail-card"><div class="detail-head"><div><span class="eyebrow">{d.demostracion?'EJEMPLO FICTICIO · NO POSTULAR':'OFERTA DE EMPLEO'}</span><h1>{d.titulo}</h1><p>{d.empresa}</p></div>{!d.demostracion&&<a class="apply-large" href={d.aplicarUrl} target="_blank" rel="noopener noreferrer nofollow">Aplicar ahora ↗</a>}</div><div class="detail-tags"><span>🌍 {d.pais}</span><span>📍 {d.ciudad}</span><span>💼 {d.tipo}</span><span>🏠 {d.modalidad}</span><span>💰 {d.salario||'Salario no indicado'}</span></div><div class="detail-body"><h2>Descripción del empleo</h2><p>{d.descripcion}</p><h2>Requisitos</h2><ul>{d.requisitos.map(r=><li>{r}</li>)}</ul><h2>Información de la vacante</h2><p>Publicado: {d.fecha}{d.vence?` · Vence: ${d.vence}`:''}{d.fuente?` · Fuente: ${d.fuente}`:''}</p><p>Comprueba siempre la vigencia y autenticidad de la oferta en la página original antes de compartir información personal.</p>{!d.demostracion&&<a class="apply-large" href={d.aplicarUrl} target="_blank" rel="noopener noreferrer nofollow">Ir a la postulación ↗</a>}</div></article></div></section></Base>
